NODE_ENV=production
PORT=3000
PUBLIC_SITE_URL=https://theagentbureau.xyz
DATABASE_URL=mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/YOUR_DB_NAME

# The game: Claude plays the suspects. Without a key, questions fail.
ANTHROPIC_API_KEY=

# Operator inbox sign-in. Leave either blank to keep /inbox locked; the server
# also keeps it locked, and says why at start, when either is too weak.
# OPERATOR_PASSWORD: five or more random words, or 20 or more random
#   characters. Anything zxcvbn estimates at fewer than 10^14 guesses, as typed
#   or with spaces and separators taken out, or shorter than 16 characters, is
#   refused.
# SESSION_SECRET: the hex of at least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing either one signs out every open session.
OPERATOR_PASSWORD=
SESSION_SECRET=
# Optional: the operator's own addresses or networks, comma-separated, left out
# of the sign-in limit for all addresses (DEPLOYMENT.md, Operator inbox).
OPERATOR_LOGIN_ADDRESSES=

# CounterAudit, used by the operator intake script
# (docs/counteraudit-intake.md). The production server also needs
# COUNTERAUDIT_ORG_ID (and COUNTERAUDIT_API_URL if not the default) for the
# daily pnpm lines expire. COUNTERAUDIT_ORG_ID is the Bureau's
# CounterAudit organization; COUNTERAUDIT_INGEST_KEY is an API key of that org
# with the ingest role, which also seals each evidence result the intake stores.
# COUNTERAUDIT_READ_KEY is an API key of that org with the read role, for
# pnpm file assemble and verify --current to read those seals back.
COUNTERAUDIT_API_URL=https://api.counteraudit.io
COUNTERAUDIT_ORG_ID=
COUNTERAUDIT_INGEST_KEY=
COUNTERAUDIT_READ_KEY=

# The independent review log (docs/two-person-review.md). Where the Bureau
# runs: the review organization's id and the Bureau's own read key to it, for
# pnpm review sync. On a reviewer's machine instead: that reviewer's own ingest
# key, for pnpm review submit.
COUNTERAUDIT_REVIEW_ORG_ID=
COUNTERAUDIT_REVIEW_READ_KEY=
COUNTERAUDIT_REVIEW_INGEST_KEY=

# Arc testnet JSON-RPC, read-only, used by the intake's evidence check
# (docs/evidence-verifier.md). Defaults to the public endpoint.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_EXPLORER_URL=https://explorer.testnet.arc.io
