NODE_ENV=production
PORT=3000
PUBLIC_SITE_URL=https://theagentbureau.xyz
DATABASE_URL=mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/YOUR_DB_NAME

# The game: Claude plays the suspects. Without a key, questions fail.
ANTHROPIC_API_KEY=

# Operator inbox sign-in. Leave either blank to keep /inbox locked.
# OPERATOR_PASSWORD: a long, unique passphrase (16+ characters).
# SESSION_SECRET: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing SESSION_SECRET signs out every open session.
OPERATOR_PASSWORD=
SESSION_SECRET=

# CounterAudit, used only by the operator intake script
# (docs/counteraudit-intake.md). COUNTERAUDIT_ORG_ID is the Bureau's
# CounterAudit organization; COUNTERAUDIT_INGEST_KEY is an API key of that org
# with the ingest role.
COUNTERAUDIT_API_URL=https://api.counteraudit.io
COUNTERAUDIT_ORG_ID=
COUNTERAUDIT_INGEST_KEY=

# Arc testnet JSON-RPC, read-only, used by the intake's evidence check
# (docs/evidence-verifier.md). Defaults to the public endpoint.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_EXPLORER_URL=https://explorer.testnet.arc.io
